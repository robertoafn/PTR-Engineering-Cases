{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/robertoafn/PTR-Engineering-Cases/schemas/simulation_run.schema.json",
  "title": "PTR SimulationRun",
  "description": "Registro inmutable de una inspección o ejecución de simulación.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "scenario_id",
    "run_type",
    "version_role",
    "status",
    "recorded_at_utc",
    "software",
    "model",
    "artifacts",
    "execution",
    "evidence",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "$ref": "#/$defs/identifier"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[0-9]{3}(?:_[a-z0-9]+(?:_[a-z0-9]+)*)?$"
    },
    "scenario_id": {
      "$ref": "#/$defs/identifier"
    },
    "run_type": {
      "enum": [
        "inspection",
        "simulation",
        "sensitivity",
        "optimization",
        "uncertainty",
        "data_regression"
      ]
    },
    "version_role": {
      "enum": [
        "source_baseline",
        "reference_reproduction",
        "exploratory_migration",
        "target_reproducible"
      ]
    },
    "status": {
      "enum": ["completed", "failed", "aborted", "partial"]
    },
    "recorded_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "software": {
      "$ref": "#/$defs/software"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "validation_result_ids": {
      "$ref": "#/$defs/id_list"
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version_role": {
            "const": "target_reproducible"
          }
        },
        "required": ["version_role"]
      },
      "then": {
        "properties": {
          "status": {
            "const": "completed"
          },
          "software": {
            "properties": {
              "release_channel": {
                "const": "stable"
              }
            }
          },
          "model": {
            "properties": {
              "parameter_set": {
                "properties": {
                  "provenance_status": {
                    "not": {
                      "const": "missing"
                    }
                  }
                }
              }
            }
          },
          "artifacts": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "role": {
                      "const": "simulation_input"
                    }
                  },
                  "required": ["role"]
                }
              },
              {
                "contains": {
                  "properties": {
                    "role": {
                      "const": "simulation_output"
                    }
                  },
                  "required": ["role"]
                }
              },
              {
                "contains": {
                  "properties": {
                    "role": {
                      "const": "result_dataset"
                    }
                  },
                  "required": ["role"]
                }
              }
            ]
          },
          "execution": {
            "required": ["started_at_utc", "ended_at_utc"],
            "properties": {
              "recalculated": {
                "const": true
              },
              "clean_start": {
                "const": true
              },
              "convergence_status": {
                "const": "verified_converged"
              }
            }
          },
          "evidence": {
            "properties": {
              "evidence_mode": {
                "const": "simulated"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "mode": {
                "const": "saved_state_inspection"
              }
            },
            "required": ["mode"]
          }
        },
        "required": ["execution"]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "recalculated": {
                "const": false
              },
              "clean_start": {
                "const": false
              },
              "convergence_status": {
                "const": "saved_state_only"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "recalculated": {
                "const": false
              }
            },
            "required": ["recalculated"]
          }
        },
        "required": ["execution"]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "convergence_status": {
                "enum": ["saved_state_only", "unknown"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[_:.-][a-z0-9]+)*$"
    },
    "id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "release_channel"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "build_version": {
          "type": "string",
          "minLength": 1
        },
        "release_label": {
          "type": "string",
          "minLength": 1
        },
        "release_channel": {
          "enum": ["stable", "release_candidate", "development", "unknown"]
        },
        "edition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "thermodynamic_model",
        "enthalpy_model",
        "parameter_set"
      ],
      "properties": {
        "model_id": {
          "$ref": "#/$defs/identifier"
        },
        "thermodynamic_model": {
          "type": "string",
          "minLength": 1
        },
        "enthalpy_model": {
          "type": "string",
          "minLength": 1
        },
        "parameter_set": {
          "$ref": "#/$defs/parameter_set"
        }
      }
    },
    "parameter_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_set_id",
        "provenance_status",
        "auto_estimated",
        "source_ids"
      ],
      "properties": {
        "parameter_set_id": {
          "$ref": "#/$defs/identifier"
        },
        "provenance_status": {
          "enum": [
            "software_builtin",
            "documented_external",
            "estimated_by_software",
            "not_applicable",
            "missing"
          ]
        },
        "auto_estimated": {
          "type": "boolean"
        },
        "source_ids": {
          "$ref": "#/$defs/id_list"
        },
        "values_artifact_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance_status": {
                "enum": [
                  "software_builtin",
                  "documented_external",
                  "estimated_by_software"
                ]
              }
            },
            "required": ["provenance_status"]
          },
          "then": {
            "required": ["values_artifact_id"],
            "properties": {
              "source_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "auto_estimated": {
                "const": true
              }
            },
            "required": ["auto_estimated"]
          },
          "then": {
            "properties": {
              "provenance_status": {
                "const": "estimated_by_software"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance_status": {
                "const": "estimated_by_software"
              }
            },
            "required": ["provenance_status"]
          },
          "then": {
            "properties": {
              "auto_estimated": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "role", "sha256", "immutable"],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "role": {
          "enum": [
            "source_simulation",
            "simulation_input",
            "simulation_output",
            "parameter_set",
            "run_log",
            "result_dataset",
            "validation_result",
            "figure"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "immutable": {
          "const": true
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "recalculated",
        "clean_start",
        "convergence_status"
      ],
      "properties": {
        "mode": {
          "enum": ["saved_state_inspection", "manual_gui", "automation_api"]
        },
        "recalculated": {
          "type": "boolean"
        },
        "clean_start": {
          "type": "boolean"
        },
        "convergence_status": {
          "enum": [
            "saved_state_only",
            "reported_success",
            "verified_converged",
            "failed",
            "unknown"
          ]
        },
        "started_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "operating_system": {
          "type": "string",
          "minLength": 1
        },
        "solver": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_mode", "data_origin", "source_ids"],
      "properties": {
        "evidence_mode": {
          "enum": [
            "experimental",
            "calculated",
            "simulated",
            "estimated",
            "documentary"
          ]
        },
        "data_origin": {
          "enum": ["empirical", "literature", "synthetic", "hypothetical"]
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_id",
        "agent_ids",
        "used_artifact_ids",
        "generated_artifact_ids",
        "derived_from_run_ids"
      ],
      "properties": {
        "activity_id": {
          "$ref": "#/$defs/identifier"
        },
        "agent_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "used_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "generated_artifact_ids": {
          "$ref": "#/$defs/id_list"
        },
        "derived_from_run_ids": {
          "$ref": "#/$defs/id_list"
        }
      }
    }
  }
}
